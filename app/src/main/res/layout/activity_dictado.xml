<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><com.google.android.material.button.MaterialButton android:id="@+id/btnAtrasDictado" style="@style/Bitacora.IconButton" app:icon="@drawable/ic_back" android:contentDescription="Volver" android:tooltipText="Volver" app:backgroundTint="@color/soft_green" app:iconTint="@color/primary" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" style="@style/Bitacora.Title" android:id="@+id/txtTituloDictado" android:text="Dictado" android:layout_marginStart="16dp" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_soft" android:padding="20dp" android:layout_marginTop="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Bitacora.Caption" android:text="APUNTE SELECCIONADO" android:gravity="start" android:letterSpacing="0.08" />
<TextView android:id="@+id/txtTemaDictado" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/ink" android:layout_marginTop="8dp" />
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Bitacora.Title" android:id="@+id/txtTituloTexto" android:text="De tu voz al papel" android:textSize="24sp" android:layout_marginTop="28dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Bitacora.Caption" android:id="@+id/txtAyudaDictado" android:text="Toca el micrófono y habla. Puedes corregir el texto antes de guardarlo." android:gravity="start" android:textSize="15sp" android:lineSpacingExtra="4dp" android:layout_marginTop="8dp" />
<LinearLayout android:id="@+id/panelMicrofono" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="24dp"><com.google.android.material.button.MaterialButton android:id="@+id/btnMicrofono" style="@style/Bitacora.IconButton" app:icon="@drawable/ic_mic" android:contentDescription="Dictar descripción" android:tooltipText="Dictar descripción" android:layout_width="80dp" android:layout_height="80dp" app:cornerRadius="28dp" app:iconSize="36dp" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Bitacora.Caption" android:id="@+id/txtEtiquetaMicrofono" android:text="Dictar descripción" android:layout_marginTop="8dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/btnTranscribirAudio" style="@style/Bitacora.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transcribir audio guardado" app:icon="@drawable/ic_notes" app:backgroundTint="@color/soft_green" android:textColor="@color/primary" app:iconTint="@color/primary" android:layout_marginTop="20dp" />
<TextView android:id="@+id/txtEstadoTranscripcion" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Bitacora.Caption" android:text="Transcripción en español, sin conexión." android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Descripción" android:layout_marginTop="14dp" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
 <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtTextoDictado" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textSize="16sp" android:textColor="@color/ink" android:inputType="textMultiLine|textCapSentences" android:minLines="6" android:gravity="top|start" />
 </com.google.android.material.textfield.TextInputLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnGuardarDescripcion" style="@style/Bitacora.PrimaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Guardar Descripción" app:icon="@drawable/ic_save" android:layout_marginTop="20dp" />
</LinearLayout></ScrollView>