<resources>
    <style name="Base.Theme.MyBitacoraUTH" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
    </style>
    <style name="Theme.MyBitacoraUTH" parent="Base.Theme.MyBitacoraUTH" />
    <style name="Bitacora.Title" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Bitacora.Caption" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Bitacora.Label" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Bitacora.IconButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconSize">26dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>
    <style name="Bitacora.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
    </style>
</resources>
